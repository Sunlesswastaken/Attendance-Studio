# Attendance Studio - environment variables for local runs and hosting.
# Copy to .env for local development. On Render, set the secret values in the
# dashboard (or via render.yaml with sync: false). Never commit real secrets.

# Bind address / port used by the production start command (Render injects PORT).
HOST=0.0.0.0
PORT=8000
OPEN_BROWSER=0

# Shared login. CHANGE these from the old admin / iare@cdc values before hosting.
ATTENDANCE_TEST_USERNAME=admin
ATTENDANCE_TEST_PASSWORD=change-this-to-a-strong-password

# Set to 1 when served over HTTPS (Render serves HTTPS by default).
COOKIE_SECURE=1

# Folder holding the nominal-roll spreadsheets.
NOMINAL_ROLLS_DIR=/app/NOMINAL ROLLS

# Optional AI-assisted query interpretation. Leave blank to use the built-in rules.
OPENAI_API_KEY=
OPENAI_MODEL=
